@charset "utf-8";

body { margin: 0px; background-color: rgb(255, 255, 255); color: rgb(0, 0, =
0); }

table { border: 0px; }

.cal-wrap { border: 1px solid rgb(43, 140, 206); overflow: hidden; zoom: 1;=
 background: rgb(255, 255, 255); position: absolute; z-index: 2000; }

.cal { width: 261px; font-size: 12px; background: rgb(255, 255, 255); float=
: left; }

.cal-top { height: 20px; line-height: 20px; background: rgb(255, 255, 255);=
 color: rgb(0, 55, 132); padding: 5px 10px; position: relative; z-index: 20=
00; }

.cal-right .cal-top { text-align: right; }

.cal-top select { font-size: 12px; vertical-align: middle; }

.cal-top input { padding: 0px; }

.cal-top a { float: left; width: 16px; height: 16px; background: url("../im=
ages/img.gif") no-repeat; vertical-align: middle; }

.cal-top .first { background-position: 0px 0px; margin-right: 5px; }

.cal-top .prev { background-position: -16px 0px; margin-right: 5px; }

.cal-top .next { background-position: -32px 0px; margin-left: 5px; }

.cal-top .last { background-position: -48px 0px; margin-left: 5px; }

.cal-top .next, .cal-top .last { float: right; }

.cal-week { margin: 0px -1px 0px 0px; padding: 0px; height: 25px; border-ri=
ght: 1px solid rgb(221, 221, 221); background: rgb(189, 235, 239); }

.cal-right .cal-week { border-left: 1px solid rgb(221, 221, 221); }

.cal-week li { float: left; width: 36px; text-align: center; line-height: 2=
5px; list-style: none; }

.cal-week li b { font-weight: normal; color: rgb(198, 11, 2); }

.cal-cm { clear: left; border-top: 1px solid rgb(221, 221, 221); border-rig=
ht: 1px solid rgb(221, 221, 221); position: relative; margin-right: -1px; m=
in-height: 100px; }

.cal-right .cal-cm { border-left: 1px solid rgb(221, 221, 221); }

.cal-cm .cell { position: absolute; width: 36px; height: 18px; text-align: =
center; }

.cal-cm .cell .so { font: bold 12px =E5=AE=8B=E4=BD=93; }

.cal-ft { clear: both; text-align: right; height: 20px; padding: 4px 10px; =
background: rgb(255, 255, 255); border-top: 1px solid rgb(221, 221, 221); w=
idth: 502px; }

.cal-ft .cal-btn { display: inline-block; height: 20px; width: 50px; text-a=
lign: center; text-decoration: none; color: rgb(41, 116, 5); background: rg=
b(241, 241, 241); border: 1px solid rgb(205, 205, 205); font-size: 12px; li=
ne-height: 20px; cursor: pointer; }

.cal-top a { float: left; margin: 2px 0px 0px; }

.cal-top .year { float: left; position: relative; margin-right: 10px; }

.cal-top .year input { width: 50px; height: 18px; line-height: 18px; border=
: 0px none; background: rgb(255, 255, 255); text-align: center; }

.cal-top .month { float: left; position: relative; }

.cal-top .month input { width: 50px; height: 18px; line-height: 18px; borde=
r: 0px none; background: rgb(255, 255, 255); text-align: center; }

.cal-top .time-list { position: absolute; top: 20px; left: 0px; border: 1px=
 solid rgb(221, 221, 221); width: 90px; background: rgb(255, 255, 255); pad=
ding: 0px; margin: 0px; list-style: none; overflow: hidden; zoom: 1; z-inde=
x: 1000; display: none; }

.cal-top .time-list ul { margin: 0px; padding: 0px; overflow: hidden; zoom:=
 1; }

.cal-top .time-list li { float: left; width: 40px; list-style: none; height=
: 20px; line-height: 20px; padding-left: 5px; cursor: pointer; }

.cal-top .time-list .dis { color: rgb(153, 153, 153); }

.cal-right .month, .cal-right .year { float: right; text-align: left; }

.cal-top .time-list-ft { text-align: center; padding: 0px 10px; }

.cal-top .time-list-ft a { margin: 0px; background: none; height: 20px; lin=
e-height: 20px; text-decoration: none; font-size: 12px; float: none; }

.cal-top .time-list-ft .close { font-size: 16px; display: inline-block; wid=
th: 20px; text-align: center; }

.cal-top .time-list-ft .close:hover { background: rgb(190, 235, 238); }

.fl { float: left !important; }

.fr { float: right !important; }

.cal-one { width: 261px; }

.cal-one .cal-right { display: none; }

.cal-one .cal-top .prev { margin-right: 34px; }

.cal-one .cal-ft { width: 241px; }

.is-caring .cal { font-size: 18px; }

.is-caring .cal-top select { font-size: 18px; }

.is-caring .cal-ft .cal-btn { font-size: 18px; }

.is-caring .cal-top .time-list-ft a { font-size: 18px; }

.is-caring .cal-top .time-list-ft .close { font-size: 22px; }

.is-caring .cal { font-size: 18px; }

.is-caring .cal-cm .cell .so { font: bold 18px =E5=AE=8B=E4=BD=93; white-sp=
ace: nowrap; }

.is-caring .cal-cm .holiday { width: 20px; height: 20px; line-height: 20px;=
 font-size: 18px; display: none; }

.is-caring .cal-ft .cal-btn { height: 20px; line-height: 20px; font-size: 1=
8px; vertical-align: top; }

.is-caring .cal-cm .cell .so { line-height: 18px; }
